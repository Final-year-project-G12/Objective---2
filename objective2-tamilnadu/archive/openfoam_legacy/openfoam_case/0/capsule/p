FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

// Solids don't solve for pressure; heSolidThermo still expects this file to
// exist (shared compressible-thermo I/O framework). Uniform placeholder.
dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    axis
    {
        type            symmetryPlane;
    }
    frontAndBack
    {
        type            empty;
    }
    ".*"
    {
        type            calculated;
        value           uniform 1e5;
    }
}
