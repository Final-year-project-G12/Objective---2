state: tamilnadu
state_config_version: state_config_tamilnadu_v2.0_2026-09-17
objective1_manifest: data/objective1/manifest.json
shared_config:
  system_config: configs/system_config_shared.yaml
  design_bounds: configs/design_bounds_shared.yaml
pareto_tolerance_pct: 5.0
demand_profile:
  file: data/demand/demand_profile_tamilnadu.csv
  daily_total_L: 300.0
  documented_reason: 'Matches 04b_climate_signature.py''s DRAW_VOLUME_L=300 assumption (Avargani et al.
    2021) so Objective 1''s L_required figures and Objective 2''s simulated solar fraction evaluate the
    same household. Unaffected by the 2026-09-17 Objective 1 refresh (Objective 2''s own demand assumption,
    not derived from Objective 1). See build_demand_profile.py docstring.

    '
mains_temperature_C:
  range_low: 23.97
  range_high: 28.46
  source: 'Per-medoid T_mains_est_C from the 2026-09-17 refreshed data/objective1/signatures/climate_signature_tamilnadu.csv
    (was a hand-set 22-30C state-level band before this refresh; now the actual range spanned by this
    state''s 3 regime medoids).

    '
climate_signature_sanity_check:
  annual_GHI_daily_kWh_expected_band:
  - 4.0
  - 5.6
  humidity_signature_expected: RH_mean > 60% in most clusters (coastal/humid)
  elevation_note: 'RESOLVED as of the 2026-09-17 refresh: tamilnadu_pipeline now runs 00c_attach_elevation.py
    (previously Tamil Nadu had no dedicated elevation script and used a flat 150 m approximation). Real
    elevation now varies 44-627 m across the 3 regime medoids -- cluster 1''s medoid (TNP_0007, 626.9
    m) is a genuine highland/Nilgiris-adjacent point, not a flat-terrain approximation.

    '
  status: PASSED
  evidence: 'cluster_profiles_tamilnadu.csv (fresh run): GHI_daily_kWh in [5.15, 5.32] kWh/m2/day (inside
    expected band); mean Ta in [27.1, 29.7] C — consistent with Tamil Nadu''s coastal/interior tropical
    signature, not e.g. Rajasthan''s hot-dry or Uttarakhand''s elevation-dominated signature.

    '
