FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

// 343.15 K = 70 C, the real solar-collector peak/tank-inlet temperature
// used throughout Objective 2.
dimensions      [0 0 0 1 0 0 0];

internalField   uniform 343.15;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 343.15;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 343.15;
        value           uniform 343.15;
    }
    wall_outer
    {
        type            zeroGradient;
    }
    axis
    {
        type            symmetryPlane;
    }
    frontAndBack
    {
        type            empty;
    }
    water_to_capsule
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     fluidThermo;
        value           uniform 343.15;
    }
}
