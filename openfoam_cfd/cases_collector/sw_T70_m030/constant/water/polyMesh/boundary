FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/water/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    inlet
    {
        type            patch;
        nFaces          64;
        startFace       17536;
    }
    outlet
    {
        type            patch;
        nFaces          64;
        startFace       17600;
    }
    symWater
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          800;
        startFace       17664;
    }
    water_to_copper
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          2400;
        startFace       18464;
        sampleMode      nearestPatchFace;
        sampleRegion    copper;
        samplePatch     copper_to_water;
    }
)

