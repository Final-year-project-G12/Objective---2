FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


application     buoyantPimpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         14400;

deltaT          0.05;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       5.0;

writeControl    adjustableRunTime;
writeInterval   600;
purgeWrite      3;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;

functions
{
    meltAndTemp
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       volAverage;
        weightField     rho;
        fields          (T "solidificationMeltingSource1:alpha1");
        writeFields     no;
        log             no;
        writeControl    adjustableRunTime;
        writeInterval   10;
    }
    meltExtrema
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       max;
        fields          (T);
        writeFields     no;
        log             no;
        writeControl    adjustableRunTime;
        writeInterval   10;
    }
    meltMin
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       min;
        fields          (T);
        writeFields     no;
        log             no;
        writeControl    adjustableRunTime;
        writeInterval   10;
    }
    totalVolume
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       volIntegrate;
        fields          (rho);
        writeFields     no;
        log             no;
        writeControl    onEnd;
    }
    wallFlux
    {
        type            wallHeatFlux;
        libs            (fieldFunctionObjects);
        patches         (wall);
        writeFields     no;
        log             no;
        writeControl    adjustableRunTime;
        writeInterval   10;
    }
    wallQ
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            wall;
        operation       areaIntegrate;
        fields          (wallHeatFlux);
        writeFields     no;
        log             no;
        writeControl    adjustableRunTime;
        writeInterval   10;
    }
}

