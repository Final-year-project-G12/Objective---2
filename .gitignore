# ============================================================
# OpenFOAM generated output (openfoam_cfd/)
# ============================================================
# Solver logs are named log.<solver> (log.solver, log.blockMesh, ...), so the
# "*.log" rule above never matched them. Individual files reached 100-285 MB,
# over GitHub's 100 MB per-file limit, and the first push carried ~1.15 GiB
# of packed objects. Everything here is regenerated by running the cases.
openfoam_cfd/**/log.*
openfoam_cfd/**/log
openfoam_cfd/**/postProcessing/
openfoam_cfd/**/processor*/
openfoam_cfd/**/VTK/
openfoam_cfd/**/*.foam
openfoam_cfd/**/*.vtk
openfoam_cfd/**/*.vtu
openfoam_cfd/**/*.vtp
# Time-step directories (0.5, 100, 1e-05, ...) hold the solved fields.
# The initial-conditions directory is kept so a case can still be run.
openfoam_cfd/**/[0-9]*/
!openfoam_cfd/**/0/
!openfoam_cfd/**/0.orig/

# Any other single file over the GitHub limit should be caught before commit:
#   git diff --cached --name-only | % { Get-Item -LiteralPath $_ } | ? Length -gt 50MB
