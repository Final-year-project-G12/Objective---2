# Oversize Objective-1 intermediates (exceed GitHub's 100 MB file limit).
# Regenerate locally with the Objective-1 pipeline scripts.
data/objective1/*/suntimes.csv
data/objective1/rajasthan/daily_aggregates_rajasthan.csv
data/objective1/tamil_nadu/daily_aggregates_tamilnadu.csv

# Objective 2 regeneratable outputs — these are what was blowing up .git size
# and causing push timeouts (53 tracked interactive HTML files alone, ~4-5MB
# each; one 14MB models.pkl). All are reproducible via `pipeline.py --stage
# plots` / `--stage surrogate` and don't belong in source control.
**/results/plots/interactive/*.html
**/results/**/surrogate/models.pkl
**/results/*_surrogate_models.pkl
*.pkl

# Accidental output path from an unexpanded `--state` CLI placeholder
# (objective2-tamilnadu/results/--state/) — a script bug, not real data.
results/--state/

